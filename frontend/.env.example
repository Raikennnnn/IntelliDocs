# ----------------------------------------------------------------------
# Frontend (Vite) environment template
#
# Copy this file to `frontend/.env.local` (preferred) or `frontend/.env`
# and adjust the values for your machine.  Vite picks them up at startup
# and inlines `VITE_*` vars into the client bundle, so changes require
# restarting `npm run dev`.
# ----------------------------------------------------------------------

# AI verification service (Flask, runs from `ai/app.py`)
# Default works when `python app.py` is started locally with default port.
VITE_AI_BASE_URL=http://127.0.0.1:5000

# CodeIgniter API proxy target.
# - Use http://127.0.0.1 when serving the PHP app through XAMPP Apache.
# - Use http://127.0.0.1:8080 when running `php spark serve` directly.
VITE_API_TARGET=http://127.0.0.1

# Path under which CodeIgniter's `public/` is exposed by the API target.
# - XAMPP, project at htdocs/IntelliDocs : /IntelliDocs/public
# - XAMPP, project at htdocs/<other-name>: /<other-name>/public
# - `php spark serve` (no prefix)        : leave blank
VITE_API_BASE=/IntelliDocs/public

# Optional placeholder used on public marketing pages whenever copy needs
# to refer to "a student" without naming a real one. When unset (the
# default), public pages omit such references entirely. Set this only
# when the school has explicit consent to reference a student under a
# generic descriptor (e.g. "a current NSDGA student").
# VITE_PUBLIC_STUDENT_PLACEHOLDER=

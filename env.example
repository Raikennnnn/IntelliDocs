# ----------------------------------------------------------------------
# IntelliDocs environment template
#
# Copy this file to `env` (no extension, no leading dot) at the project
# root.  `api/env_loader.php` reads it on every PHP request so values
# can change without restarting Apache.
#
# Never commit `env` to git -- it contains secrets.  Only this template
# (`env.example`) belongs in version control.
# ----------------------------------------------------------------------

# Database (CodeIgniter + raw PDO API both read these)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=intellidocs_db
DB_USER=root
DB_PASS=

# AI verification service (Flask, see ai/app.py)
AI_BASE_URL=http://127.0.0.1:5000
# OCR: auto | tesseract | easyocr  (on Python 3.13+ auto prefers Tesseract; EasyOCR needs PyTorch)
AI_OCR_ENGINE=auto
# Multi-level OCR: enhanced Tesseract (PSM 6/11/4) always for PSA, SF9, SF10/137; other types when weak read
# DISABLE_OCR_FALLBACK=1
# AI_OCR_FALLBACK_MIN_CONF=0.38
# AI_OCR_FALLBACK_MIN_WORDS=10
# AI_OCR_PRELOAD_EASYOCR=1
# DISABLE_EASYOCR=1
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Email transport.  `phpmail` works on XAMPP only if Mercury/sendmail is set up;
# `brevo` uses Brevo's transactional API and works anywhere with internet.
MAIL_PROVIDER=phpmail
BREVO_API_KEY=
MAIL_FROM_ADDRESS=no-reply@intellidocs.local
MAIL_FROM_NAME=IntelliDocs

# Local-only: show OTP on screen when email send fails (0 = off, use with Brevo)
MAIL_DEV_OTP_FALLBACK=0

# Signup: reject emails whose domain has no usable MX records (1 = on, 0 = off for local testing)
EMAIL_MX_CHECK=1

# Optional: override the public URL used in emails / redirects.
APP_BASE_URL=http://localhost/IntelliDocs/public
# Optional: web path prefix before /api and /uploads (auto-derived from APP_BASE_URL when unset).
# XAMPP subfolder: /IntelliDocs/public   Droplet at site root: leave empty or set APP_BASE_URL=http://YOUR_IP
# APP_PUBLIC_PATH=/IntelliDocs/public

# Session tokens (Bearer auth) — replaces trusting X-User-Id alone
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_LIFETIME_HOURS=12
# Set to 0 to keep users logged in across server restarts (default: invalidate on restart)
SESSION_INVALIDATE_ON_RESTART=1
AUTH_ALLOW_LEGACY_HEADER=1
# Login MFA OTP after password (admin, registrar, and student portals)
AUTH_LOGIN_OTP_REQUIRED=1

# OTP rate limits (per email, per flow, rolling 1-hour window)
# OTP_MAX_REQUESTS_PER_HOUR=6
# OTP_MAX_REQUESTS_PER_HOUR_LOGIN=6
# OTP_MAX_REQUESTS_PER_HOUR_REGISTRATION=6
# OTP_MAX_REQUESTS_PER_HOUR_PASSWORD_RESET=6
# OTP_MAX_ATTEMPTS=5
# OTP_LOCKOUT_MINUTES=15

# Login brute-force protection
AUTH_LOGIN_FAILURE_THRESHOLD=5
AUTH_LOGIN_FAILURE_WINDOW_MINUTES=5

# Rapid sequential action anomaly (paper: >10 actions in 2 minutes)
RAPID_ACTION_THRESHOLD=15
RAPID_ACTION_WINDOW_MINUTES=2

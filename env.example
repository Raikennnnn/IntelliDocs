# ----------------------------------------------------------------------
# IntelliDocs environment template
#
# Copy this file to `env` (no extension, no leading dot) at the project
# root.  `api/env_loader.php` reads it on every PHP request so values
# can change without restarting Apache.
#
# Never commit `env` to git -- it contains secrets.  Only this template
# (`env.example`) belongs in version control.
# ----------------------------------------------------------------------

# Database (CodeIgniter + raw PDO API both read these)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=intellidocs_db
DB_USER=root
DB_PASS=

# AI verification service (Flask, see ai/app.py)
AI_BASE_URL=http://127.0.0.1:5000

# Email transport.  `phpmail` works on XAMPP only if Mercury/sendmail is set up;
# `brevo` uses Brevo's transactional API and works anywhere with internet.
MAIL_PROVIDER=phpmail
BREVO_API_KEY=
MAIL_FROM_ADDRESS=no-reply@intellidocs.local
MAIL_FROM_NAME=IntelliDocs

# Optional: override the public URL used in emails / redirects.
APP_BASE_URL=http://localhost/IntelliDocs/public
